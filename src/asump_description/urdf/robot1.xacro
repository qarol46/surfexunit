  </link>
  <joint name="fl_ultrasonic_joint" type="fixed">
    <parent link="face_sensors_mount_link"/>
    <child link="fl_ultrasonic_link"/>
    <origin xyz="-0.121493 0.028454 -0.0025" rpy="0 0 0"/>
  </joint>

