<?xml version="1.0" ?>
<robot name="surfex_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />

  <link name="base_link">
    <inertial>
      <origin xyz="0.029988 -0.025095 0.220398" rpy="0 0 0"/>
      <mass value="7.5"/>
      <inertia ixx="30.467843" iyy="12.939223" izz="40.525852" ixy="0.000666" iyz="-0.336034" ixz="0.000112"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="file://$(find asump_description)/meshes/base_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name=""><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="file://$(find asump_description)/meshes/base_link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="body_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="30.467843" iyy="12.939223" izz="40.525852" ixy="0.000666" iyz="-0.336034" ixz="0.000112"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find asump_description)/meshes/body_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find asump_description)/meshes/body_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0.0 0.0 0.1445" rpy="0 0 0"/> 
  </joint>

  <link name="face_sensor_panel">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
      <mass value="0.4"/>
      <inertia ixx="0.000511" iyy="0.011306" izz="0.011176" ixy="-3e-05" iyz="-2.8e-05" ixz="1.1e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
      <geometry><mesh filename="file://$(find asump_description)/meshes/face_sensor_panel.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name=""><color rgba="1 0.4318 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
      <geometry><mesh filename="file://$(find asump_description)/meshes/face_sensor_panel.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <joint name="face_sensors_mount_joint" type="fixed">
    <parent link="body_link"/>
    <child link="face_sensor_panel"/>
    <origin xyz="0.4625 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000577" iyy="0.000577" izz="0.00083" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find asump_description)/meshes/lidar_link1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name=""><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find asump_description)/meshes/lidar_link1.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="laser"/>
    <origin xyz="0.1425 0.0 0.373" rpy="0 0 0"/>
  </joint>

  <xacro:sensor_d435 parent="face_sensor_panel" name="camera" use_nominal_extrinsics="true">
    <origin xyz="0.02 0.0 0.01" rpy="0 0 0"/>
  </xacro:sensor_d435>


  <xacro:macro name="wheel" params="prefix xyz rpy">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="${0.5 * (3 * 0.1 * 0.1 + 0.05 * 0.05) / 12}" 
                 iyy="${0.5 * 0.1 * 0.1 / 2}" 
                 izz="${0.5 * (3 * 0.1 * 0.1 + 0.05 * 0.05) / 12}" 
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file://$(find asump_description)/meshes/wheel_link.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        <material name=""><color rgba="0.2 0.2 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find asump_description)/meshes/wheel_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="fl" xyz="0.314 0.2519 0" rpy="0 0 0"/>
  <xacro:wheel prefix="fr" xyz="0.314 -0.2519 0" rpy="0 0 0"/>
  <xacro:wheel prefix="rl" xyz="-0.314 0.2519 0" rpy="0 0 0"/>
  <xacro:wheel prefix="rr" xyz="-0.314 -0.2519 0" rpy="0 0 0"/>

