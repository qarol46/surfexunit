<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--

      RGB-D depth camera mount (Intel RealSense D435i default).
      Typical placement: front of base_link at xyz="0.22 0.0 0.18".
      Topics:
        /depth_camera/color/image_raw       (RGB)
        /depth_camera/depth/image_rect_raw  (depth)
        /depth_camera/depth/points          (PointCloud2)
      Optical frames follow REP-103 convention (z-forward, x-right, y-down).
    
  -->
  <xacro:macro name="rlai_depth_camera" params="parent xyz rpy model">
    <link name="depth_camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://realsense2_description/meshes/d415.stl"/>
        </geometry>
        <material name="camera_dark_gray">
          <color rgba="0.12 0.12 0.14 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
      </collision>
      <!--inertial>
        <mass value="0.072"/>
        <inertia ixx="0.000010" ixy="0" ixz="0" iyy="0.000010" iyz="0" izz="0.000010"/>
      </inertial-->
    </link>

    <joint name="depth_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="depth_camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- RGB optical frame (REP-103: z-forward, x-right, y-down) -->
    <link name="depth_camera_rgb_optical_frame"/>

    <joint name="depth_camera_rgb_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="depth_camera_rgb_optical_frame"/>
      <!-- Rotate from body (x-forward) to optical (z-forward): pitch -90°, roll -90° -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Depth optical frame -->
    <link name="depth_camera_depth_optical_frame"/>

    <joint name="depth_camera_depth_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="depth_camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Depth + RGB sensors + visual material — single reference block so
        the <visual> material override is not overwritten by a later block -->
    <gazebo reference="depth_camera_link">
      <visual>
        <material>
          <ambient>0.15 0.16 0.18 1.0</ambient>
          <diffuse>0.22 0.23 0.26 1.0</diffuse>
          <specular>0.5 0.5 0.55 1.0</specular>
        </material>
      </visual>
      <sensor name="depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/depth_camera/depth</topic>
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <camera name="depth_camera">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
      </sensor>
      <!--sensor name="rgb_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/depth_camera/image_raw</topic>
        <gz_frame_id>depth_camera_rgb_optical_frame</gz_frame_id>
        <camera name="rgb_camera">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
      </sensor-->
    </gazebo>

  </xacro:macro>
</robot>