<?xml version="1.0"?>
<robot name="asump0_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Подключение всех модулей -->
  <xacro:include filename="base_link.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <!--xacro:include filename="side_camera.xacro"/-->
  <!--xacro:include filename="ros2_control.xacro"/-->
  <!--xacro:include filename="depth_camera.xacro"/-->
  <!--xacro:include filename="$(find realsense2_description)/urdf/_d415.urdf.xacro" /-->
  <xacro:include filename="imu.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  <!--xacro:include filename="$(find realsense_ros_gazebo)/xacro/depthcam.xacro"/-->

  <!-- Базовые параметры робота -->
  <xacro:property name="robot_name" value="asump0"/>

  <!-- Вызов макросов -->

  <!-- Установка LIDAR -->
  <xacro:lidar parent_link="base_link" x="0.496510223719" y="0" z="0.596484004557" roll="0" pitch="0" yaw="0"/>

  <!-- Установка камер
  <xacro:left_parking_sensor parent_link="base_link" x="-0.25577" y="0.26863" z="0.46916" roll="0" pitch="-0.087266" yaw="1.5708"/>
  
  <xacro:right_parking_sensor parent_link="base_link" x="-0.25577" y="-0.26863" z="0.46916" roll="0" pitch="-0.087266" yaw="-1.5708"/>
  -->

  <!--xacro:depth_camera 
    parent_link="base_link"
    x="0.648" y="-5.20230646739119E-05" z="0.253"
    roll="0" pitch="0" yaw="0"
  /-->

  <!--xacro:sensor_d415 parent="base_link" name="realsense_d415" use_nominal_extrinsics="true">
    <origin xyz="0.648 0 0.253" rpy="0 0 0"/>
  </xacro:sensor_d415-->

  <!--xacro:realsense_d435 sensor_name="d435" parent_link="base_link" rate="10">
    <origin rpy="0 0 0" xyz="0.648 0 0.253"/>
  </xacro:realsense_d435-->

  <xacro:imu_sensor 
    name="imu"
    parent_link="base_link"
    x="0" y="0" z="0.3"
    roll="0" pitch="0" yaw="0"
    update_rate="100"
  />
  
  <!-- Подключение ROS2 Control -->
  <!--xacro:ros2_control_rollers/-->

</robot>