<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <topic>/cmd_vel</topic>
            
            <!-- ВЕДУЩИЕ ТОЛЬКО ЦЕНТРАЛЬНЫЕ КОЛЕСА -->
            <left_joint>drive_left_wheel_joint</left_joint>
            <right_joint>drive_right_wheel_joint</right_joint>
            
            <!-- Расстояние между центральными колесами: 0.2519 * 2 = 0.5038 -->
            <wheel_separation>0.5038</wheel_separation>
            <!-- Радиус совпадает с мешем колеса (0.1 м по wheel_link.stl)
                 и с collision-цилиндрами всех шести колёс -->
            <wheel_radius>0.1</wheel_radius>

            <!-- Потолки симуляции (не путать с лимитами навигации в
                 path_follower.yaml — они ниже). Ускорения подняты, чтобы
                 сим не был bottleneck'ом для контроллеров. -->
            <max_linear_acceleration>3.0</max_linear_acceleration>
            <min_linear_acceleration>-3.0</min_linear_acceleration>
            <max_angular_acceleration>4.0</max_angular_acceleration>
            <min_angular_acceleration>-4.0</min_angular_acceleration>
            <max_linear_velocity>5.0</max_linear_velocity>
            <min_linear_velocity>-5.0</min_linear_velocity>
            <max_angular_velocity>3.0</max_angular_velocity>
            <min_angular_velocity>-3.0</min_angular_velocity>
            <!-- NB: gz-sim8 DiffDrive НЕ читает max_velocity/max_wheel_torque
                 (управление по JointVelocityCmd) — эти параметры удалены. -->
            <publish_odom>false</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <!-- Публикуем состояния всех колес, чтобы они крутились визуально в RViz -->
            <joint_name>fl_wheel_joint</joint_name>
            <joint_name>fr_wheel_joint</joint_name>
            <joint_name>rl_wheel_joint</joint_name>
            <joint_name>rr_wheel_joint</joint_name>
            <joint_name>drive_left_wheel_joint</joint_name>
            <joint_name>drive_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- ИСПРАВЛЕНО: Трение увеличено с 0.2 до 1.0 (иначе робот буксует как на льду) -->
    <gazebo reference="fl_wheel_link">  <mu1>1.0</mu1>  <mu2>1.0</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>
    <gazebo reference="fr_wheel_link">  <mu1>1.0</mu1>  <mu2>1.0</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>
    <gazebo reference="rl_wheel_link">  <mu1>1.0</mu1>  <mu2>1.0</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>
    <gazebo reference="rr_wheel_link">  <mu1>1.0</mu1>  <mu2>1.0</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>
    <gazebo reference="drive_left_wheel_link">  <mu1>1.2</mu1>  <mu2>1.2</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>
    <gazebo reference="drive_right_wheel_link"> <mu1>1.2</mu1>  <mu2>1.2</mu2>  <fdir1>1 0 0</fdir1>  </gazebo>

</robot>