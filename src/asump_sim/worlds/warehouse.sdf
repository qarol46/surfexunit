        <visual name="step_08"><pose>-4.0 -1.567 1.372 0 0 0</pose><geometry><box><size>2.0 0.66 0.2</size></box></geometry><material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
