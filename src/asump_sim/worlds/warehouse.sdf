          <material>
            <ambient>0.65 0.65 0.68 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ОПОРНЫЕ СТОЛБЫ МЕЗОНИНА (в цвет стен) -->
    <!-- Столб 1: поддерживает угол возле рампы -->
    <model name="mezzanine_pillar_01">
      <static>true</static>
      <pose>-4.0 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Столб 2: поддерживает дальний северо-западный угол -->
    <model name="mezzanine_pillar_02">
      <static>true</static>
      <pose>4.0 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
