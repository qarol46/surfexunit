    <!-- ВТОРОЙ ЯРУС (МЕЗОНИН) -->
    <!-- ========================================== -->
    <model name="mezzanine_floor">
      <static>true</static>
      <pose>0.0 5.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 10.0 0.1</size></box></geometry>
        </collision>
