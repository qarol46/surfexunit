<?xml version="1.0"?>
<sdf version="1.11">
  <world name="benchmark_warehouse_medium">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>70 70</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>70 70</size></plane></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual></link></model>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 12 0 0 0</pose><diffuse>0.85 0.85 0.85 1</diffuse><direction>-0.4 0.2 -0.9</direction></light>

    <model name="wall_north"><static>true</static><pose>0 10 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20.4 0.2 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>20.4 0.2 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -10 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20.4 0.2 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>20.4 0.2 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>10 0 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20.0 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20.0 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-10 0 1.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 20.0 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 20.0 2.8</size></box></geometry><material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual></link></model>

    <include><name>shelf_medium_01</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>-7 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_02</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>-7 0 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_03</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>-7 -6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_04</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>0 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_05</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>0 1.8 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_06</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>0 -6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_07</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>7 6 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_08</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>7 0 0 0 0 1.5708</pose></include>
    <include><name>shelf_medium_09</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>7 -6 0 0 0 1.5708</pose></include>
    <include><name>pallet_medium_01</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile</uri><pose>-4 -9 0 0 0 0.4</pose></include>
    <include><name>pallet_medium_02</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile</uri><pose>4 9 0 0 0 -0.2</pose></include>
    
    <include><name>forklift_01</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Forklift</uri><pose>4.5 -6 0 0 0 1.57</pose></include>
    <include><name>forklift_02</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Forklift</uri><pose>-4.5 6 0 0 0 3.14</pose></include>

    <include><name>shelf_medium_10</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>-3 -5 0 0 0 0</pose></include>
    <include><name>shelf_medium_11</name><uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf</uri><pose>4 4 0 0 0 0</pose></include>

  </world>
</sdf>
