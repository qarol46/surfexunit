        <visual name="visual"><geometry><box><size>0.2 20.0 4.0</size></box></geometry>
        <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.0 -10.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.2 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.0 0.2 4.0</size></box></geometry>
        <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0 10.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.2 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.0 0.2 4.0</size></box></geometry>
        <material><ambient>0.82 0.82 0.84 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material></visual>
      </link>
